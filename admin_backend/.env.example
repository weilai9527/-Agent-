# 历史配置字段样本。日常部署使用各原生服务的专属环境，参见 deploy/MICROSERVICES.md。
DB_ENGINE=sqlite
SQLITE_PATH=../backend/data/dev.sqlite

# MySQL 部署时再切换：
# 历史字段示例：DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=multi_agent_interview
MYSQL_CHARSET=utf8mb4

ADMIN_FRONTEND_ORIGIN=http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://localhost:5174,http://localhost:5175,http://localhost:5176

# 旧管理端的独立管理员认证配置，供离线兼容流程使用。
# 已设置的 ADMIN_MASTER_* 字段优先于对应的 ADMIN_BOOTSTRAP_* 字段。
# 旧流程会在启动和登录时按这些配置同步主管理员账号。
# 需配置有效邮箱及至少 12 个字符的密码。
# 管理员凭据由部署方提供，系统不内置默认密码。
ADMIN_MASTER_EMAIL=
ADMIN_MASTER_PASSWORD=
ADMIN_MASTER_NAME=系统管理员
# 可选的旧版兼容变量。对应的 ADMIN_MASTER_* 字段为空时使用。
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=系统管理员
ADMIN_BOOTSTRAP_ROLE=super_admin
ADMIN_SESSION_MAX_AGE=28800
ADMIN_COOKIE_SECURE=false

# 旧流程用此密钥加密学生首次激活前的临时密码。
# 生产数据需要保持 Fernet 密钥稳定。可用下方命令生成新密钥。
# 离线生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STUDENT_TEMP_PASSWORD_KEY=
